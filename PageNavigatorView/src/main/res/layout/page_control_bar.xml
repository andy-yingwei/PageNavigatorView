<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- 左：上一页 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPrev"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:minWidth="48dp"
        android:text="@string/left_button_text"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_left"
        android:drawablePadding="4dp"
        android:backgroundTint="@android:color/transparent" />

    <!-- 中间：页码显示 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPageIndicator"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:minWidth="80dp"
        android:text="@string/page_indicator_text"
        android:textSize="14sp"
        android:drawableEnd="@drawable/ic_jump_down"
        android:drawablePadding="4dp"
        android:backgroundTint="@android:color/transparent"/>

    <!-- 右：下一页 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:minWidth="48dp"
        android:text="@string/right_button_text"
        android:textSize="14sp"
        android:drawableEnd="@drawable/ic_right"
        android:drawablePadding="4dp"
        android:backgroundTint="@android:color/transparent"/>

</LinearLayout>