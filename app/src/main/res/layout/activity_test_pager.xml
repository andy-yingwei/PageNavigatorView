<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFffffff">

    <!-- 顶部占位 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PageNavigatorView 测试"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:textColor="#FF000000" />

    <!-- ★ 核心：你的自定义分页控件 -->
    <com.example.pagenavigatorview.PageNavigatorView
        android:id="@+id/pageNavigator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:pic_barBackgroundColor="#FFFFFFFF"
        app:pic_barStrokeWidthDp="1"
        app:pic_barStrokeColor="#FF000000"/>

    <!-- 中间分隔 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFDDDDDD"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <!-- 显示回调结果的区域 -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待操作..."
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#FF333333"
        android:lineSpacingExtra="6dp" />

    <!-- 底部控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetMax"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="设置 maxPage=30"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="重置到第1页"
            android:textSize="14sp"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测试项：\n1. 点上一页/下一页 → 看回调\n2. 点中间指示器 → 弹窗跳转\n3. 点底部按钮 → 动态改 maxPage / 重置"
        android:textSize="12sp"
        android:textColor="#FF666666"
        android:layout_marginTop="48dp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>